{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "prisma/**",
      "src/**",
      "tsconfig.json",
      "next.config.js",
      "package.json",
      "package-lock.json",
      "*.bat",
      "*.cmd",
      "*.exe",
      "*.ps1",
      "*.sh",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.ps1",
      "**/*.sh",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/admin*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
