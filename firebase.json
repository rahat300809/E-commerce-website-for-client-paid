{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "prisma/**",
      "src/**",
      "tsconfig.json",
      "next.config.js",
      "package.json",
      "package-lock.json",
      "*.bat",
      "*.cmd",
      "*.exe",
      "*.ps1",
      "*.sh",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.ps1",
      "**/*.sh",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/shop",
        "destination": "/index.html"
      },
      {
        "source": "/customizer",
        "destination": "/index.html"
      },
      {
        "source": "/checkout",
        "destination": "/index.html"
      },
      {
        "source": "/preorders",
        "destination": "/preorders.html"
      },
      {
        "source": "/product",
        "destination": "/product.html"
      },
      {
        "source": "/account",
        "destination": "/account.html"
      }
    ],
    "headers": [
      {
        "source": "**/admin*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
