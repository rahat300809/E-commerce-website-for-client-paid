rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ZENVY store data — public reads (storefront), authenticated writes (admin only)
    match /zenvy_store/{document=**} {
      allow read: if true;
      // Only Firebase-authenticated users can write.
      // Admin panel authenticates via Google Sign-In (firebase.auth).
      // Master-password-only admins cannot write to Firestore — they stay localStorage-only.
      allow write: if request.auth != null;
    }
  }
}
