rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ZENVY store data — storefront, orders & admin sync
    match /zenvy_store/{document=**} {
      allow read, write: if true;
    }

    // Admins whitelist collection
    match /admins/{email} {
      allow read, write: if true;
    }
  }
}
